# PhoenixCI Configuration Example
# LLM Provider Configuration
GROQ_API_KEY=replace_with_your_rotated_groq_api_key
GROQ_MODEL=replace_with_a_model_available_to_your_groq_account
LLM_PROVIDER=groq
LLM_MODE=mock
GROQ_MAX_COMPLETION_TOKENS=2048
GROQ_TIMEOUT_SECONDS=45
GROQ_MAX_RETRIES=2

# PhoenixCI Orchestration and Approval Controls
REQUIRE_HUMAN_APPROVAL=true
AUTO_MERGE_ENABLED=false
MAX_REPAIR_ATTEMPTS=2

# GitHub Integration (optional for local/mock mode)
GITHUB_TOKEN=replace_with_scoped_github_token
GITHUB_REPOSITORY=owner/phoenixci

# EC2 Deployment Configuration (optional until configured)
DEPLOY_ENABLED=false
EC2_HOST=
EC2_USER=ubuntu
EC2_SSH_KEY_PATH=
APP_PORT=3000

# Foundly frontend Supabase connection (publishable/anon key only)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace_with_your_supabase_anon_key
